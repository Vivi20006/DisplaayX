# Copy to .env and fill in. `npm start` loads it automatically.

NODE_ENV=production
PORT=3000
# Public address of the site – used for email links and OAuth redirect URIs.
PUBLIC_URL=https://displayx.lol
# Behind nginx/Caddy/Cloudflare: number of proxies to trust (for correct client IPs in rate limiting).
TRUST_PROXY=1

# REQUIRED in production, at least 32 random characters:  openssl rand -hex 48
JWT_SECRET=
# Optional separate key for encrypting 2FA secrets at rest (defaults to one derived from JWT_SECRET).
DATA_ENCRYPTION_KEY=
SESSION_TTL=30d

DB_PATH=./data/displayx.db

# SMTP for verification + password reset mails. Without SMTP_HOST, mails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DisplayX <no-reply@displayx.lol>"

# Google: https://console.cloud.google.com/apis/credentials  (OAuth client, type "Web application")
#   Authorised redirect URI: ${PUBLIC_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord: https://discord.com/developers/applications → OAuth2
#   Redirect: ${PUBLIC_URL}/api/oauth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# The installer. Either put the file at ./downloads/DisplayX.exe (or set DOWNLOAD_FILE),
# or set DOWNLOAD_URL to redirect signed-in users to e.g. a CDN / GitHub release asset.
DOWNLOAD_FILE=
DOWNLOAD_URL=
APP_VERSION=1.1.0
APP_SIZE_LABEL=~69 MB

# Only if the site's HTML is hosted on another origin than the API (comma-separated).
CORS_ORIGINS=
